{
  "name": "@kargonomi/desktop",
  "version": "2.5.0-Enterprise",
  "private": true,
  "type": "module",
  "description": "Kargonomi API için güvenli Electron ve React masaüstü yönetim istemcisi.",
  "main": "dist-electron/main.mjs",
  "author": "Hamza Deniz Yılmaz ve Beyza Gül",
  "contributors": [
    "Hamza Deniz Yılmaz",
    "Beyza Gül"
  ],
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/hamzadenizyilmaz/Kargonomi-Deskop-APP#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzadenizyilmaz/Kargonomi-Deskop-APP.git"
  },
  "bugs": {
    "url": "https://github.com/hamzadenizyilmaz/Kargonomi-Deskop-APP/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "packageManager": "npm@12.0.2",
  "keywords": [
    "kargonomi",
    "electron",
    "react",
    "shipping",
    "desktop"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "dev": "vite --config vite.renderer.config.ts",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "package:dir": "npm run build && electron-builder --dir --win",
    "package:win": "npm run build && electron-builder --win nsis",
    "setup": "npm run package:win && node scripts/collect-setup.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@kargonomi/client": "file:../NodeJS",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "dev.hamzadenizyilmaz.kargonomi.desktop",
    "productName": "Kargonomi Masaüstü İstemcisi",
    "copyright": "Telif hakkı © 2026 Hamza Deniz Yılmaz ve Beyza Gül",
    "artifactName": "Kargonomi-Masaustu-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "appsettings.json",
      "package.json"
    ],
    "directories": {
      "output": "artifacts"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hamzadenizyilmaz",
        "repo": "Kargonomi-Deskop-APP"
      }
    ]
  }
}
